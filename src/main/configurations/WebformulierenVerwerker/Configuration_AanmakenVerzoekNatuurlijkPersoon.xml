<?xml version="1.0" encoding="UTF-8"?>
<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../FrankConfig.xsd">
    <Adapter name="aanmakenVerzoekNatuurlijkPersoon">
        <Receiver name="aanmakenVerzoekNatuurlijkPersoon">
            <JavaListener name="aanmakenVerzoekNatuurlijkPersoon"/>
        </Receiver>

        <Pipeline>
            <Exits>
                <Exit name="SUCCESS" state="SUCCESS"/>
                <Exit name="EXCEPTION" state="ERROR"/>
            </Exits>

            <!-- Foutcontext: onthoudt in welke stap het misgaat, zonder de berichtstroom te verstoren -->
            <PutInSessionPipe name="SetStap_InlezenVelden" sessionKey="ErrorInfo"
                               value="Inlezen SOAP-velden uit binnenkomend verzoek (afzenderbsn, bestandsnamen, bestandsdata)"/>

            <!-- Sla ruwe SOAP-velden op -->
            <XsltPipe name="GetAfzenderBsn" xpathExpression="//afzenderbsn">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAfzenderBsn" sessionKey="AfzenderBsn"/>

            <XsltPipe name="GetAanvraagpdfname" xpathExpression="//aanvraagpdfname" getInputFromSessionKey="originalMessage">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAanvraagpdfname" sessionKey="Aanvraagpdfname"/>

            <XsltPipe name="GetAanvraagpdfdata" xpathExpression="//aanvraagpdfdata" getInputFromSessionKey="originalMessage">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAanvraagpdfdata" sessionKey="Aanvraagpdfdata"/>

            <XsltPipe name="GetAanvraagxmlname" xpathExpression="//aanvraagxmlname" getInputFromSessionKey="originalMessage">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAanvraagxmlname" sessionKey="Aanvraagxmlname"/>

            <XsltPipe name="GetAanvraagxmldata" xpathExpression="//aanvraagxmldata" getInputFromSessionKey="originalMessage">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAanvraagxmldata" sessionKey="Aanvraagxmldata"/>

            <PutInSessionPipe name="SetStap_DecoderenXml" sessionKey="ErrorInfo"
                               value="Decoderen van het base64-gecodeerde aanvraag-XML"/>

            <!-- Decodeer base64 XML → lees aanvraagtype, omschrijving, vertrouwelijkheid uit het XML-formulier -->
            <Base64Pipe name="DecodeAanvraagXml" direction="DECODE" getInputFromSessionKey="Aanvraagxmldata">
                <Forward name="success" path="StoreAanvraagXmlDecoded"/>
                <Forward name="exception" path="isErrorXML"/>
            </Base64Pipe>
            <PutInSessionPipe name="StoreAanvraagXmlDecoded" sessionKey="AanvraagXmlDecoded"/>

            <PutInSessionPipe name="SetStap_UitlezenAanvraagtype" sessionKey="ErrorInfo"
                               value="Uitlezen aanvraagtype/omschrijving/vertrouwelijkheid uit het aanvraag-XML"/>

            <XsltPipe name="GetAanvraagtype" xpathExpression="//aanvraagtype" getInputFromSessionKey="AanvraagXmlDecoded">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAanvraagtype" sessionKey="Aanvraagtype"/>

            <XsltPipe name="GetOmschrijving" xpathExpression="//omschrijving" getInputFromSessionKey="AanvraagXmlDecoded">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreOmschrijving" sessionKey="Omschrijving"/>

            <XsltPipe name="GetVertrouwelijkheid" xpathExpression="//vertrouwelijkheid" getInputFromSessionKey="AanvraagXmlDecoded">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreVertrouwelijkheid" sessionKey="Vertrouwelijkheid"/>

            <PutInSessionPipe name="SetStap_JwtOphalen" sessionKey="ErrorInfo"
                               value="Genereren van JWT-token voor de ZAC Documenten API"/>

            <!-- Haal vers JWT op voor Documenten API calls -->
            <SenderPipe name="GetZacJwtToken">
                <IbisLocalSender javaListener="ZacJwtToken"/>
                <Forward name="success" path="StoreZacJwtToken"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>
            <PutInSessionPipe name="StoreZacJwtToken" sessionKey="ZacJwtToken"/>

            <PutInSessionPipe name="SetStap_UploadenPdf" sessionKey="ErrorInfo"
                               value="Uploaden van de aanvraag-PDF naar de ZAC Documenten API"/>
            <PutInSessionPipe name="SetTargetUrl_UploadPdf" sessionKey="TargetUrl"
                               value="${zac.documenten.url}/enkelvoudiginformatieobjecten"/>

            <!-- Stap 1: Upload PDF naar Documenten API -->
            <XsltPipe name="Transform_UploadPdf_Body"
                      styleSheetName="xsl/AanmakenVerzoekNatuurlijkPersoon/uploadPdf_request.xsl"
                      getInputFromFixedValue="&lt;Default/&gt;"
                      omitXmlDeclaration="true">
                <Param name="bronorganisatie" value="${zac.bronorganisatie}"/>
                <Param name="informatieobjecttype" value="${zac.documenten.informatieobjecttype}"/>
                <Param name="bestandsnaam" sessionKey="Aanvraagpdfname"/>
                <Param name="inhoud" sessionKey="Aanvraagpdfdata"/>
                <Param name="vertrouwelijkheidaanduiding" sessionKey="Vertrouwelijkheid"/>
                <Forward name="success" path="Send_UploadPdf"/>
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>

            <SenderPipe name="Send_UploadPdf">
                <HttpSender url="${zac.documenten.url}/enkelvoudiginformatieobjecten"
                            methodType="POST"
                            contentType="application/json"
                            headersParams="Authorization"
                            timeout="12500">
                    <Param name="Authorization" sessionKey="ZacJwtToken"/>
                </HttpSender>
                <Forward name="success" path="WrapPdfResponse"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>

            <Text2XmlPipe name="WrapPdfResponse" xmlTag="response">
                <Forward name="success" path="GetPdfDocumentUrl"/>
                <Forward name="exception" path="isErrorXML"/>
            </Text2XmlPipe>

            <XsltPipe name="GetPdfDocumentUrl"
                      styleSheetName="xsl/Common/extractDrcUuid.xsl">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StorePdfDocumentUrl" sessionKey="PdfDocumentUuid"/>

            <PutInSessionPipe name="SetStap_UploadenXml" sessionKey="ErrorInfo"
                               value="Uploaden van het aanvraag-XML naar de ZAC Documenten API"/>
            <PutInSessionPipe name="SetTargetUrl_UploadXml" sessionKey="TargetUrl"
                               value="${zac.documenten.url}/enkelvoudiginformatieobjecten"/>

            <!-- Stap 2: Upload XML-formulierdata naar Documenten API -->
            <XsltPipe name="Transform_UploadXml_Body"
                      styleSheetName="xsl/AanmakenVerzoekNatuurlijkPersoon/uploadXml_request.xsl"
                      getInputFromFixedValue="&lt;Default/&gt;"
                      omitXmlDeclaration="true">
                <Param name="bronorganisatie" value="${zac.bronorganisatie}"/>
                <Param name="informatieobjecttype" value="${zac.documenten.informatieobjecttype}"/>
                <Param name="bestandsnaam" sessionKey="Aanvraagxmlname"/>
                <Param name="inhoud" sessionKey="Aanvraagxmldata"/>
                <Param name="vertrouwelijkheidaanduiding" sessionKey="Vertrouwelijkheid"/>
                <Forward name="success" path="Send_UploadXml"/>
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>

            <SenderPipe name="Send_UploadXml">
                <HttpSender url="${zac.documenten.url}/enkelvoudiginformatieobjecten"
                            methodType="POST"
                            contentType="application/json"
                            headersParams="Authorization"
                            timeout="12500">
                    <Param name="Authorization" sessionKey="ZacJwtToken"/>
                </HttpSender>
                <Forward name="success" path="WrapXmlResponse"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>

            <Text2XmlPipe name="WrapXmlResponse" xmlTag="response">
                <Forward name="success" path="GetXmlDocumentUrl"/>
                <Forward name="exception" path="isErrorXML"/>
            </Text2XmlPipe>

            <XsltPipe name="GetXmlDocumentUrl"
                      styleSheetName="xsl/Common/extractDrcUuid.xsl">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreXmlDocumentUrl" sessionKey="XmlDocumentUuid"/>

            <!-- Genereer verzoekIdentificatie en sla alle metadata op in INFO_CACHE voor gebruik in stap 3 -->
            <UUIDGeneratorPipe name="GenerateVerzoekIdentificatie"
                               storeResultInSessionKey="VerzoekIdentificatie">
                <Forward name="exception" path="isErrorXML"/>
            </UUIDGeneratorPipe>

            <PutInSessionPipe name="SetStap_WegschrijvenCache" sessionKey="ErrorInfo"
                               value="Wegschrijven van verzoekgegevens naar de INFO_CACHE-tabel"/>

            <SenderPipe name="SlaAllesOpInCache" getInputFromFixedValue="&lt;dummy/&gt;">
                <FixedQuerySender
                    query="INSERT INTO INFO_CACHE (REGISTRATIENUMMER, VERTROUWELIJKHEID, AFZENDER, ONDERWERP, AANVRAAGTYPE, PDF_UUID, XML_UUID, AANVRAAG_XML, STOREDATE) VALUES (?, ?, ?, ?, ?, ?, ?, ?, CURRENT_DATE);" />
                <Param name="REGISTRATIENUMMER" sessionKey="VerzoekIdentificatie"/>
                <Param name="VERTROUWELIJKHEID" sessionKey="Vertrouwelijkheid"/>
                <Param name="AFZENDER" sessionKey="AfzenderBsn"/>
                <Param name="ONDERWERP" sessionKey="Omschrijving"/>
                <Param name="AANVRAAGTYPE" sessionKey="Aanvraagtype"/>
                <Param name="PDF_UUID" sessionKey="PdfDocumentUuid"/>
                <Param name="XML_UUID" sessionKey="XmlDocumentUuid"/>
                <Param name="AANVRAAG_XML" sessionKey="AanvraagXmlDecoded"/>
                <Forward name="success" path="SetStap_OpbouwenRespons"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>

            <PutInSessionPipe name="SetStap_OpbouwenRespons" sessionKey="ErrorInfo"
                               value="Opbouwen van de SOAP-respons naar Kodison"/>

            <!-- Bouw SOAP response met verzoekIdentificatie + beide DRC-URLs -->
            <XsltPipe name="ConvertToResponse"
                      styleSheetName="xsl/AanmakenVerzoekNatuurlijkPersoon/response2AanmakenVerzoekNatuurlijkPersoon.xsl"
                      getInputFromFixedValue="&lt;Default/&gt;"
                      omitXmlDeclaration="true">
                <Param name="verzoekIdentificatie" sessionKey="VerzoekIdentificatie"/>
                <Param name="pdfDocumentUuid" sessionKey="PdfDocumentUuid"/>
                <Param name="xmlDocumentUuid" sessionKey="XmlDocumentUuid"/>
                <Forward name="success" path="WrapResponse"/>
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>

            <SoapWrapperPipe name="WrapResponse" storeResultInSessionKey="originalMessageResponse">
                <Forward name="success" path="SUCCESS"/>
                <Forward name="exception" path="isErrorXML"/>
            </SoapWrapperPipe>

            <!-- Error Handling: elke tak eindigt gegarandeerd bij EXCEPTION, nooit bij een onafgevangen technische fout -->
            <IsXmlPipe name="isErrorXML">
                <Forward name="then" path="storeErrorResponse"/>
                <Forward name="else" path="errorToXML"/>
                <Forward name="exception" path="EXCEPTION"/>
            </IsXmlPipe>

            <Text2XmlPipe xmlTag="error" name="errorToXML">
                <Forward name="success" path="storeErrorResponse"/>
                <Forward name="exception" path="EXCEPTION"/>
            </Text2XmlPipe>

            <PutInSessionPipe name="storeErrorResponse">
                <Param name="aanvraagResponse"/>
                <Forward name="success" path="buildErrorMsg"/>
                <Forward name="exception" path="EXCEPTION"/>
            </PutInSessionPipe>

            <XsltPipe name="buildErrorMsg"
                      styleSheetName="xsl/Common/CreateAanvraagErrorResponse.xsl"
                      getInputFromFixedValue="&lt;dummy/&gt;">
                <Param name="aanvraagRequest" sessionKey="aanvraagRequest"/>
                <Param name="aanvraagResponse" sessionKey="aanvraagResponse"/>
                <Param name="aanvraagErrorMessage" sessionKey="aanvraagResponse" defaultValue="No Error Message"/>
                <Param name="soapAction" sessionKey="RequestSoapAction"/>
                <Param name="errorInfo" sessionKey="ErrorInfo" defaultValue="No Error Info"/>
                <Param name="targetUrl" sessionKey="TargetUrl" defaultValue=""/>
                <Forward name="success" path="EXCEPTION"/>
                <Forward name="exception" path="EXCEPTION"/>
            </XsltPipe>

        </Pipeline>
    </Adapter>
</Module>
