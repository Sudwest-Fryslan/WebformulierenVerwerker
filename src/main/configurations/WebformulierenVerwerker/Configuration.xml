<!DOCTYPE configuration [
<!ENTITY Version SYSTEM "Configuration_Version.xml">
<!ENTITY Info SYSTEM "Configuration_Info.xml">
<!ENTITY OpslaanInkNatuurlijkPersoon SYSTEM "Configuration_OpslaanInkNatuurlijkPersoon.xml">
<!ENTITY OpslaanInkNietNatuurlijkPersoon SYSTEM "Configuration_OpslaanInkNietNatuurlijkPersoon.xml">
<!ENTITY OpslaanBijlage SYSTEM "Configuration_OpslaanBijlage.xml">
<!ENTITY OpslaanInk SYSTEM "Configuration_OpslaanInk.xml">
<!ENTITY OpslaanAanvraagNatuurlijkPersoon SYSTEM "Configuration_OpslaanAanvraagNatuurlijkPersoon.xml">
<!ENTITY OpslaanAanvraagBijlage SYSTEM "Configuration_OpslaanAanvraagBijlage.xml">
<!ENTITY ZacJwtToken SYSTEM "Configuration_ZacJwtToken.xml">
<!ENTITY AanmakenVerzoekNatuurlijkPersoon SYSTEM "Configuration_AanmakenVerzoekNatuurlijkPersoon.xml">
<!ENTITY ToevoegenVerzoekDocument SYSTEM "Configuration_ToevoegenVerzoekDocument.xml">
<!ENTITY IndienenVerzoek SYSTEM "Configuration_IndienenVerzoek.xml">
<!ENTITY CleanupVerlopenVerzoeken SYSTEM "Configuration_CleanupVerlopenVerzoeken.xml">
<!ENTITY WebformulierenVerwerkerDispatcher SYSTEM "Configuration_WebformulierenVerwerkerDispatcher.xml">
]>
<Configuration>
    <Scheduler>
        <Job name="CleanupVerlopenVerzoeken"
             cronExpression="0 0 2 * * ?"
             function="sendMessage"
             adapterName="CleanupVerlopenVerzoeken"
             javaListener="CleanupVerlopenVerzoeken"
             description="Ruim verlopen verzoeken op ouder dan 7 dagen (stap 3 nooit aangeroepen)"/>
    </Scheduler>
    <SharedResources>
        <HttpSession
            name="SharedHttpSession"
            maxConnections="1"
            connectionTimeToLive="100000"
            />
    </SharedResources>
    &Version;
    &Info;
    &OpslaanInkNatuurlijkPersoon;
    &OpslaanInkNietNatuurlijkPersoon;
    &OpslaanBijlage;
    &OpslaanInk;
    &OpslaanAanvraagNatuurlijkPersoon;
    &OpslaanAanvraagBijlage;
    &ZacJwtToken;
    &AanmakenVerzoekNatuurlijkPersoon;
    &ToevoegenVerzoekDocument;
    &IndienenVerzoek;
    &CleanupVerlopenVerzoeken;
    &WebformulierenVerwerkerDispatcher;
</Configuration>