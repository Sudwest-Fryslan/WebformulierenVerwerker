<?xml version="1.0" encoding="UTF-8"?>
<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../FrankConfig.xsd">
    <Adapter name="toevoegenVerzoekDocument">
        <Receiver name="toevoegenVerzoekDocument">
            <JavaListener name="toevoegenVerzoekDocument"/>
        </Receiver>

        <Pipeline>
            <Exits>
                <Exit name="SUCCESS" state="SUCCESS"/>
                <Exit name="EXCEPTION" state="ERROR"/>
            </Exits>

            <!-- Foutcontext: onthoudt in welke stap het misgaat, zonder de berichtstroom te verstoren -->
            <PutInSessionPipe name="SetStap_InlezenVelden" sessionKey="ErrorInfo"
                               value="Inlezen SOAP-velden uit binnenkomend verzoek (verzoekIdentificatie, documenttype, bestandsnaam, bestandsdata)"/>

            <!-- Sla inputvelden op in sessie -->
            <XsltPipe name="GetVerzoekIdentificatie" xpathExpression="//verzoekIdentificatie">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreVerzoekIdentificatie" sessionKey="VerzoekIdentificatie"/>

            <XsltPipe name="GetDocumenttype" xpathExpression="//documenttype" getInputFromSessionKey="originalMessage">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreDocumenttype" sessionKey="Documenttype"/>

            <XsltPipe name="GetVertrouwelijkheid" xpathExpression="//vertrouwelijkheid" getInputFromSessionKey="originalMessage">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreVertrouwelijkheid" sessionKey="Vertrouwelijkheid"/>

            <XsltPipe name="GetFilename" xpathExpression="//filename" getInputFromSessionKey="originalMessage">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreFilename" sessionKey="Filename"/>

            <XsltPipe name="GetFiledata" xpathExpression="//filedata" getInputFromSessionKey="originalMessage">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreFiledata" sessionKey="Filedata"/>

            <PutInSessionPipe name="SetStap_JwtOphalen" sessionKey="ErrorInfo"
                               value="Genereren van JWT-token voor de ZAC Documenten API"/>

            <!-- Haal vers JWT op voor Documenten API call -->
            <SenderPipe name="GetZacJwtToken">
                <IbisLocalSender javaListener="ZacJwtToken"/>
                <Forward name="success" path="StoreZacJwtToken"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>
            <PutInSessionPipe name="StoreZacJwtToken" sessionKey="ZacJwtToken"/>

            <PutInSessionPipe name="SetStap_UploadenBijlage" sessionKey="ErrorInfo"
                               value="Uploaden van de bijlage naar de ZAC Documenten API"/>
            <PutInSessionPipe name="SetTargetUrl_UploadBijlage" sessionKey="TargetUrl"
                               value="${zac.documenten.url}/enkelvoudiginformatieobjecten"/>

            <!-- Upload bijlage/document naar Documenten API -->
            <XsltPipe name="Transform_UploadBijlage_Body"
                      styleSheetName="xsl/ToevoegenVerzoekDocument/uploadBijlage_request.xsl"
                      getInputFromFixedValue="&lt;Default/&gt;"
                      omitXmlDeclaration="true">
                <Param name="bronorganisatie" value="${zac.bronorganisatie}"/>
                <Param name="informatieobjecttype" value="${zac.documenten.informatieobjecttype.bijlage}"/>
                <Param name="documenttype" sessionKey="Documenttype"/>
                <Param name="bestandsnaam" sessionKey="Filename"/>
                <Param name="inhoud" sessionKey="Filedata"/>
                <Param name="vertrouwelijkheidaanduiding" sessionKey="Vertrouwelijkheid"/>
                <Forward name="success" path="Send_UploadBijlage"/>
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>

            <SenderPipe name="Send_UploadBijlage">
                <HttpSender url="${zac.documenten.url}/enkelvoudiginformatieobjecten"
                            methodType="POST"
                            contentType="application/json"
                            headersParams="Authorization"
                            timeout="12500">
                    <Param name="Authorization" sessionKey="ZacJwtToken"/>
                </HttpSender>
                <Forward name="success" path="WrapBijlageResponse"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>

            <Text2XmlPipe name="WrapBijlageResponse" xmlTag="response">
                <Forward name="success" path="GetBijlageDocumentUrl"/>
                <Forward name="exception" path="isErrorXML"/>
            </Text2XmlPipe>

            <XsltPipe name="GetBijlageDocumentUrl"
                      styleSheetName="xsl/Common/extractDrcUuid.xsl">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreBijlageDocumentUrl" sessionKey="BijlageUuid"/>

            <PutInSessionPipe name="SetStap_WegschrijvenBijlage" sessionKey="ErrorInfo"
                               value="Wegschrijven van de bijlage-UUID naar de VERZOEK_BIJLAGEN-tabel"/>

            <!-- Sla bijlage-UUID op in VERZOEK_BIJLAGEN zodat stap 3 alle bijlagen kan ophalen -->
            <SenderPipe name="SlaVerzoekBijlageOp" getInputFromFixedValue="&lt;dummy/&gt;">
                <FixedQuerySender
                    query="INSERT INTO VERZOEK_BIJLAGEN (REGISTRATIENUMMER, BIJLAGE_UUID) VALUES (?, ?)" />
                <Param name="REGISTRATIENUMMER" sessionKey="VerzoekIdentificatie"/>
                <Param name="BIJLAGE_UUID" sessionKey="BijlageUuid"/>
                <Forward name="success" path="SetStap_OpbouwenRespons"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>

            <PutInSessionPipe name="SetStap_OpbouwenRespons" sessionKey="ErrorInfo"
                               value="Opbouwen van de SOAP-respons naar Kodison"/>

            <!-- Bouw SOAP response — geef de bijlage-UUID terug aan Kodison -->
            <XsltPipe name="ConvertToResponse"
                      styleSheetName="xsl/ToevoegenVerzoekDocument/response2ToevoegenVerzoekDocument.xsl"
                      getInputFromFixedValue="&lt;Default/&gt;"
                      omitXmlDeclaration="true">
                <Param name="bijlageUuid" sessionKey="BijlageUuid"/>
                <Forward name="success" path="WrapResponse"/>
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>

            <SoapWrapperPipe name="WrapResponse" storeResultInSessionKey="originalMessageResponse">
                <Forward name="success" path="SUCCESS"/>
                <Forward name="exception" path="isErrorXML"/>
            </SoapWrapperPipe>

            <!-- Error Handling: elke tak eindigt gegarandeerd bij EXCEPTION, nooit bij een onafgevangen technische fout -->
            <IsXmlPipe name="isErrorXML">
                <Forward name="then" path="storeErrorResponse"/>
                <Forward name="else" path="errorToXML"/>
                <Forward name="exception" path="EXCEPTION"/>
            </IsXmlPipe>

            <Text2XmlPipe xmlTag="error" name="errorToXML">
                <Forward name="success" path="storeErrorResponse"/>
                <Forward name="exception" path="EXCEPTION"/>
            </Text2XmlPipe>

            <PutInSessionPipe name="storeErrorResponse">
                <Param name="aanvraagResponse"/>
                <Forward name="success" path="buildErrorMsg"/>
                <Forward name="exception" path="EXCEPTION"/>
            </PutInSessionPipe>

            <XsltPipe name="buildErrorMsg"
                      styleSheetName="xsl/Common/CreateAanvraagErrorResponse.xsl"
                      getInputFromFixedValue="&lt;dummy/&gt;">
                <Param name="aanvraagRequest" sessionKey="aanvraagRequest"/>
                <Param name="aanvraagResponse" sessionKey="aanvraagResponse"/>
                <Param name="aanvraagErrorMessage" sessionKey="aanvraagResponse" defaultValue="No Error Message"/>
                <Param name="soapAction" sessionKey="RequestSoapAction"/>
                <Param name="errorInfo" sessionKey="ErrorInfo" defaultValue="No Error Info"/>
                <Param name="targetUrl" sessionKey="TargetUrl" defaultValue=""/>
                <Forward name="success" path="EXCEPTION"/>
                <Forward name="exception" path="EXCEPTION"/>
            </XsltPipe>

        </Pipeline>
    </Adapter>
</Module>
