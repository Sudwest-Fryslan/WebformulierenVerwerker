<?xml version="1.0" encoding="UTF-8"?>
<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../FrankConfig.xsd">
    <Adapter name="indienenVerzoek">
        <Receiver name="indienenVerzoek">
            <JavaListener name="indienenVerzoek"/>
        </Receiver>

        <Pipeline>
            <Exits>
                <Exit name="SUCCESS" state="SUCCESS"/>
                <Exit name="EXCEPTION" state="ERROR"/>
            </Exits>

            <!-- Foutcontext: onthoudt in welke stap het misgaat, zonder de berichtstroom te verstoren -->
            <PutInSessionPipe name="SetStap_InlezenVelden" sessionKey="ErrorInfo"
                               value="Inlezen verzoekIdentificatie uit binnenkomend verzoek"/>

            <!-- Enige SOAP-input: verzoekIdentificatie -->
            <XsltPipe name="GetVerzoekIdentificatie" xpathExpression="//verzoekIdentificatie">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreVerzoekIdentificatie" sessionKey="VerzoekIdentificatie"/>

            <PutInSessionPipe name="SetStap_OpzoekenCache" sessionKey="ErrorInfo"
                               value="Opzoeken van verzoekgegevens in de INFO_CACHE-tabel"/>

            <!-- Lees alle metadata uit INFO_CACHE (opgeslagen door stap 1) -->
            <SenderPipe name="LeesAllesUitCache" getInputFromFixedValue="&lt;dummy/&gt;">
                <FixedQuerySender queryType="select"
                    query="SELECT VERTROUWELIJKHEID, AFZENDER, ONDERWERP, AANVRAAGTYPE, PDF_UUID, XML_UUID, AANVRAAG_XML FROM INFO_CACHE WHERE REGISTRATIENUMMER = ?"/>
                <Param name="REGISTRATIENUMMER" sessionKey="VerzoekIdentificatie"/>
                <Forward name="success" path="StoreInfoCacheResult"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>
            <PutInSessionPipe name="StoreInfoCacheResult" sessionKey="InfoCacheResult"/>

            <!-- Geef een duidelijke fout als het verzoek niet in de cache staat (bijv. na herstart) -->
            <XmlSwitchPipe name="CheckVerzoekBestaatInCache"
                           getInputFromSessionKey="InfoCacheResult"
                           xpathExpression="count(//row) = 0">
                <Forward name="true" path="VerzoekNietGevonden"/>
                <Forward name="false" path="SetStap_UitlezenCacheVelden"/>
                <Forward name="exception" path="isErrorXML"/>
            </XmlSwitchPipe>
            <PutInSessionPipe name="SetStap_VerzoekNietGevonden" sessionKey="ErrorInfo"
                               value="Controle of verzoekIdentificatie nog aanwezig is in de INFO_CACHE-tabel"/>
            <EchoPipe name="VerzoekNietGevonden"
                      getInputFromFixedValue="verzoekIdentificatie niet gevonden. Het verzoek is mogelijk verlopen (ouder dan 7 dagen) of de applicatie is herstart na stap 1.">
                <Forward name="success" path="isErrorXML"/>
                <Forward name="exception" path="isErrorXML"/>
            </EchoPipe>

            <PutInSessionPipe name="SetStap_UitlezenCacheVelden" sessionKey="ErrorInfo"
                               value="Uitlezen velden (afzender, omschrijving, aanvraagtype, document-UUID's) uit INFO_CACHE-resultaat"/>

            <XsltPipe name="ExtractAfzenderBsn" xpathExpression="//field[@name='AFZENDER']" getInputFromSessionKey="InfoCacheResult">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAfzenderBsn" sessionKey="AfzenderBsn"/>

            <XsltPipe name="ExtractOmschrijving" xpathExpression="//field[@name='ONDERWERP']" getInputFromSessionKey="InfoCacheResult">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreOmschrijving" sessionKey="Omschrijving"/>

            <XsltPipe name="ExtractAanvraagtype" xpathExpression="//field[@name='AANVRAAGTYPE']" getInputFromSessionKey="InfoCacheResult">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAanvraagtype" sessionKey="Aanvraagtype"/>

            <XsltPipe name="ExtractPdfUuid" xpathExpression="//field[@name='PDF_UUID']" getInputFromSessionKey="InfoCacheResult">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StorePdfDocumentUuid" sessionKey="PdfDocumentUuid"/>

            <XsltPipe name="ExtractXmlUuid" xpathExpression="//field[@name='XML_UUID']" getInputFromSessionKey="InfoCacheResult">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreXmlDocumentUuid" sessionKey="XmlDocumentUuid"/>

            <XsltPipe name="ExtractAanvraagXml" xpathExpression="//field[@name='AANVRAAG_XML']" getInputFromSessionKey="InfoCacheResult">
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>
            <PutInSessionPipe name="StoreAanvraagXml" sessionKey="AanvraagXml"/>

            <PutInSessionPipe name="SetStap_OpzoekenBijlagen" sessionKey="ErrorInfo"
                               value="Opzoeken van bijlage-UUID's in de VERZOEK_BIJLAGEN-tabel"/>

            <!-- Lees bijlage-UUIDs uit VERZOEK_BIJLAGEN (0..n bijlagen opgeslagen door stap 2) -->
            <SenderPipe name="LeesVerzoekBijlagen" getInputFromFixedValue="&lt;dummy/&gt;">
                <FixedQuerySender queryType="select"
                    query="SELECT BIJLAGE_UUID FROM VERZOEK_BIJLAGEN WHERE REGISTRATIENUMMER = ?"/>
                <Param name="REGISTRATIENUMMER" sessionKey="VerzoekIdentificatie"/>
                <Forward name="success" path="StoreBijlageUuidsXml"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>
            <PutInSessionPipe name="StoreBijlageUuidsXml" sessionKey="BijlageUuidsXml"/>

            <PutInSessionPipe name="SetStap_OpschonenCache" sessionKey="ErrorInfo"
                               value="Opschonen van INFO_CACHE en VERZOEK_BIJLAGEN na uitlezen"/>

            <!-- Verwijder cache-entries na uitlezen -->
            <SenderPipe name="VerwijderInfoCacheEntry" getInputFromFixedValue="&lt;dummy/&gt;">
                <FixedQuerySender
                    query="DELETE FROM INFO_CACHE WHERE REGISTRATIENUMMER = ?"/>
                <Param name="REGISTRATIENUMMER" sessionKey="VerzoekIdentificatie"/>
                <Forward name="success" path="VerwijderVerzoekBijlagen"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>

            <SenderPipe name="VerwijderVerzoekBijlagen" getInputFromFixedValue="&lt;dummy/&gt;">
                <FixedQuerySender
                    query="DELETE FROM VERZOEK_BIJLAGEN WHERE REGISTRATIENUMMER = ?"/>
                <Param name="REGISTRATIENUMMER" sessionKey="VerzoekIdentificatie"/>
                <Forward name="success" path="SetStap_OpbouwenProductaanvraag"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>

            <PutInSessionPipe name="SetStap_OpbouwenProductaanvraag" sessionKey="ErrorInfo"
                               value="Opbouwen van de productaanvraag-JSON"/>

            <!-- Bouw productaanvraag JSON en POST naar Objecten API -->
            <XsltPipe name="Transform_Productaanvraag_Body"
                      styleSheetName="xsl/IndienenVerzoek/productaanvraag_request.xsl"
                      getInputFromSessionKey="originalMessage"
                      omitXmlDeclaration="true">
                <Param name="bronorganisatie" value="${zac.bronorganisatie}"/>
                <Param name="objecttype" value="${zac.objecten.objecttype}"/>
                <Param name="bron.naam" value="${zac.bron.naam}"/>
                <Param name="documentenUrl" value="${zac.documenten.url}"/>
                <Param name="verzoekIdentificatie" sessionKey="VerzoekIdentificatie"/>
                <Param name="afzenderbsn" sessionKey="AfzenderBsn"/>
                <Param name="aanvraagtype" sessionKey="Aanvraagtype"/>
                <Param name="pdfDocumentUuid" sessionKey="PdfDocumentUuid"/>
                <Param name="xmlDocumentUuid" sessionKey="XmlDocumentUuid"/>
                <Param name="aanvraagXml" sessionKey="AanvraagXml" defaultValue=""/>
                <Param name="omschrijving" sessionKey="Omschrijving" defaultValue=""/>
                <Param name="bijlageUuidsXml" sessionKey="BijlageUuidsXml" defaultValue=""/>
                <Forward name="success" path="SetStap_VerstureNaarObjectenApi"/>
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>

            <PutInSessionPipe name="SetStap_VerstureNaarObjectenApi" sessionKey="ErrorInfo"
                               value="Versturen van de productaanvraag naar de ZAC Objecten API"/>
            <PutInSessionPipe name="SetTargetUrl_VerstureNaarObjectenApi" sessionKey="TargetUrl"
                               value="${zac.objecten.url}/objects"/>

            <!-- POST productaanvraag naar Objecten API → triggert dimpact-ZAC via notificatie -->
            <SenderPipe name="Send_ProductaanvraagNaarObjectenApi">
                <HttpSender url="${zac.objecten.url}/objects"
                            methodType="POST"
                            contentType="application/json"
                            headersParams="Authorization,Content-Crs"
                            timeout="12500">
                    <Param name="Authorization" value="Token ${zac.objecten.token}"/>
                    <Param name="Content-Crs" value="EPSG:4326"/>
                </HttpSender>
                <Forward name="success" path="SetStap_OpbouwenRespons"/>
                <Forward name="exception" path="isErrorXML"/>
            </SenderPipe>

            <PutInSessionPipe name="SetStap_OpbouwenRespons" sessionKey="ErrorInfo"
                               value="Opbouwen van de SOAP-respons naar Kodison"/>

            <!-- Bouw SOAP response -->
            <XsltPipe name="ConvertToResponse"
                      styleSheetName="xsl/IndienenVerzoek/response2IndienenVerzoek.xsl"
                      getInputFromFixedValue="&lt;Default/&gt;"
                      omitXmlDeclaration="true">
                <Param name="verzoekIdentificatie" sessionKey="VerzoekIdentificatie"/>
                <Forward name="success" path="WrapResponse"/>
                <Forward name="exception" path="isErrorXML"/>
            </XsltPipe>

            <SoapWrapperPipe name="WrapResponse" storeResultInSessionKey="originalMessageResponse">
                <Forward name="success" path="SUCCESS"/>
                <Forward name="exception" path="isErrorXML"/>
            </SoapWrapperPipe>

            <!-- Error Handling: elke tak eindigt gegarandeerd bij EXCEPTION, nooit bij een onafgevangen technische fout -->
            <IsXmlPipe name="isErrorXML">
                <Forward name="then" path="storeErrorResponse"/>
                <Forward name="else" path="errorToXML"/>
                <Forward name="exception" path="EXCEPTION"/>
            </IsXmlPipe>

            <Text2XmlPipe xmlTag="error" name="errorToXML">
                <Forward name="success" path="storeErrorResponse"/>
                <Forward name="exception" path="EXCEPTION"/>
            </Text2XmlPipe>

            <PutInSessionPipe name="storeErrorResponse">
                <Param name="aanvraagResponse"/>
                <Forward name="success" path="buildErrorMsg"/>
                <Forward name="exception" path="EXCEPTION"/>
            </PutInSessionPipe>

            <XsltPipe name="buildErrorMsg"
                      styleSheetName="xsl/Common/CreateAanvraagErrorResponse.xsl"
                      getInputFromFixedValue="&lt;dummy/&gt;">
                <Param name="aanvraagRequest" sessionKey="aanvraagRequest"/>
                <Param name="aanvraagResponse" sessionKey="aanvraagResponse"/>
                <Param name="aanvraagErrorMessage" sessionKey="aanvraagResponse" defaultValue="No Error Message"/>
                <Param name="soapAction" sessionKey="RequestSoapAction"/>
                <Param name="errorInfo" sessionKey="ErrorInfo" defaultValue="No Error Info"/>
                <Param name="targetUrl" sessionKey="TargetUrl" defaultValue=""/>
                <Forward name="success" path="EXCEPTION"/>
                <Forward name="exception" path="EXCEPTION"/>
            </XsltPipe>

        </Pipeline>
    </Adapter>
</Module>
